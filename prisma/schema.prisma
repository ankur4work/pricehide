// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Vercel's Node 24 runtime uses a newer base image (OpenSSL 3) than Node 20's.
  // Without an explicit target Prisma generates an engine for the build machine
  // only, and the function crashes on boot when the runtime does not match.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model AppSettings {
  id                  String   @id @default(cuid())
  shop                String   @unique
  enabled             Boolean  @default(false)
  hideAddToCart       Boolean  @default(true)
  hideOnlyOutOfStock  Boolean  @default(true)
  customMessage       String   @default("Price on Request")
  hideOnProductPage   Boolean  @default(true)
  hideOnCollection    Boolean  @default(true)
  hideOnFeatured      Boolean  @default(true)
  hideOnQuickView     Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
